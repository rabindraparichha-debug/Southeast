# Edge Function secrets for LOCAL DEVELOPMENT ONLY. Copy to supabase/functions/.env (gitignored).
# Keep comments on their own line after an empty value (KEY=   # note would make the note the value).
# Every value below is a local placeholder (mock modes, guessable local-dev-* secrets). Never copy
# this file to a hosted project: there, set PLATFORM_ENV and real, random values with
#   supabase secrets set KEY=value
# Mock modes (Razorpay, WhatsApp, the notebook-import fixture) run only when PLATFORM_ENV is local;
# left empty it counts as local only on a local stack (SUPABASE_URL http://kong:8000).
# PLATFORM_ENV: local only: leave empty or local. Hosted: staging | production
PLATFORM_ENV=

# RAZORPAY_MODE: local only. Hosted: test (live is refused unless RAZORPAY_ALLOW_LIVE=true)
RAZORPAY_MODE=mock
# RAZORPAY_KEY_ID: rzp_test_... (empty in mock mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=local-dev-webhook-secret
PUBLIC_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1
# RAZORPAY_ALLOW_LIVE=true         # ONLY after the product owner approves live keys

# WhatsApp (M4)
# WHATSAPP_MODE: local only. Hosted: live (mock is refused outside local)
WHATSAPP_MODE=mock
# WHATSAPP_ACCESS_TOKEN: Meta system-user token (live only)
WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID: platform number id (live only)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=local-dev-app-secret
WHATSAPP_VERIFY_TOKEN=local-dev-verify-token
PUBLIC_WEB_URL=http://localhost:3000

# Claude API for the chat fallback (optional; without it a rule-based fallback hands off to the kitchen)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_CHAT_MODEL=claude-haiku-5-5  # chat only (D-148); unset = ANTHROPIC_MODEL. Model choice: D-058
# AI_CONVERSATION_DAILY_CAP: model calls per conversation per IST day; then rules + hand-off (0 = AI off)
AI_CONVERSATION_DAILY_CAP=5
# AI_DAILY_CAP: model calls per IST day for the whole platform
AI_DAILY_CAP=300
# AI_TIMEOUT_MS=8000               # a slower model call is abandoned and the chat handed to the kitchen

# Route optimisation (M5). Optional: without it the built-in optimiser is used (D-067).
VROOM_URL=
VROOM_USE_ROUTING=false

# Lead intake (M7, D-150): shared keys. Sent in the X-Lead-Key header (or as the Basic auth password),
# never in the URL; only JUSTDIAL_LEAD_KEY may be in Justdial's push URL (?source=justdial&key=).
# Hosted projects refuse these local-dev-* values and keys shorter than 24 characters.
LEAD_INTAKE_KEY=local-dev-lead-key
GOOGLE_ADS_LEAD_KEY=local-dev-google-key
JUSTDIAL_LEAD_KEY=local-dev-justdial-key

# Error reporting (M8, optional): nothing is sent when empty; phone numbers are masked.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# Google Ads offline conversions (M9). mock (default) calls nothing and stores conversions as 'mock' (not
# sent); the first live run uploads them (D-151).
GOOGLE_ADS_MODE=mock
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CONVERSION_TRIAL=
GOOGLE_ADS_CONVERSION_PLAN=
GOOGLE_ADS_CONVERSION_RENEWAL=
GOOGLE_ADS_API_VERSION=v21

# Rain and heat alerts (P5). mock needs no network; live calls Open-Meteo (free, no API key).
# WEATHER_MODE: mock | live
WEATHER_MODE=mock
# WEATHER_MOCK_SCENARIO: none | rain | heat (mock mode only)
WEATHER_MOCK_SCENARIO=none
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Notebook-photo import (P6) uses ANTHROPIC_API_KEY / ANTHROPIC_MODEL above; without a key it returns a
# fixture locally and refuses (ai_not_configured) on a hosted project.
# NOTEBOOK_IMPORT_MODE=mock        # force the fixture even when a key is set (local only)

