# Edge Function secrets for local development. Copy to supabase/functions/.env (gitignored).
# In a hosted project set these with: supabase secrets set KEY=value
RAZORPAY_MODE=mock                 # mock | test (live is refused unless RAZORPAY_ALLOW_LIVE=true)
RAZORPAY_KEY_ID=                   # rzp_test_... (empty in mock mode)
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=local-dev-webhook-secret
PUBLIC_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1
# RAZORPAY_ALLOW_LIVE=true         # ONLY after the product owner approves live keys

# WhatsApp (M4)
WHATSAPP_MODE=mock                 # mock | live
WHATSAPP_ACCESS_TOKEN=             # Meta system-user token (live only)
WHATSAPP_PHONE_NUMBER_ID=          # platform number id (live only)
WHATSAPP_APP_SECRET=local-dev-app-secret
WHATSAPP_VERIFY_TOKEN=local-dev-verify-token
PUBLIC_WEB_URL=http://localhost:3000

# Claude API for the chat fallback (optional; without it a rule-based fallback hands off to the kitchen)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Route optimisation (M5). Optional: without it the built-in optimiser is used (D-067).
VROOM_URL=
VROOM_USE_ROUTING=false

# Lead intake (M7): shared keys for the lead-intake function
LEAD_INTAKE_KEY=local-dev-lead-key
GOOGLE_ADS_LEAD_KEY=local-dev-google-key

# Error reporting (M8, optional): nothing is sent when empty; phone numbers are masked.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# Google Ads offline conversions (M9). mock (default) marks conversions sent without calling Google.
GOOGLE_ADS_MODE=mock
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CONVERSION_TRIAL=
GOOGLE_ADS_CONVERSION_PLAN=
GOOGLE_ADS_CONVERSION_RENEWAL=
GOOGLE_ADS_API_VERSION=v21

# Rain and heat alerts (P5). mock needs no network; live calls Open-Meteo (free, no API key).
WEATHER_MODE=mock                  # mock | live
WEATHER_MOCK_SCENARIO=none         # none | rain | heat (mock mode only)
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Notebook-photo import (P6) uses ANTHROPIC_API_KEY / ANTHROPIC_MODEL above; without a key it returns a fixture.
# NOTEBOOK_IMPORT_MODE=mock        # force the fixture even when a key is set

