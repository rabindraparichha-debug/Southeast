# Copy to apps/web/.env.local. Values for the local stack come from `pnpm supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WhatsApp platform number (digits, with country code) for customer invites, and the grievance contact shown to customers
NEXT_PUBLIC_WHATSAPP_NUMBER=919000012345
NEXT_PUBLIC_GRIEVANCE_CONTACT=Grievance officer: (name), grievance@example.in, +91 90000 00000
# Support WhatsApp for vendors ("Help: WhatsApp the Tiffin team"), digits with country code. Hidden when unset.
# NEXT_PUBLIC_SUPPORT_WHATSAPP=919000012345

# Legal pages (D-181): operator and grievance officer. A production build against a hosted Supabase
# project fails without NEXT_PUBLIC_OPERATOR_NAME and a real NEXT_PUBLIC_GRIEVANCE_CONTACT (the
# placeholder above does not count). Local builds are not checked.
# NEXT_PUBLIC_OPERATOR_NAME=
# NEXT_PUBLIC_OPERATOR_ADDRESS=
# NEXT_PUBLIC_GRIEVANCE_OFFICER=

# Public forms (D-183): Cloudflare Turnstile site key for /find and /vendors. Empty locally (no
# widget); the matching secret TURNSTILE_SECRET_KEY is an Edge Function secret.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Error reporting (D-092): Sentry DSN for the web app. Inlined at build time, so set it before `next build`.
# Nothing is sent when unset. Phone numbers and customer-page tokens are masked before sending.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_RELEASE=tiffin-web@0.1.0

# Product analytics (optional, D-092): PostHog, public website only, off when unset and for visitors
# with Do Not Track. Turn on only after the privacy policy mentions analytics.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Login channels offered, in order (docs/LOGIN.md). Unset = sms, which is what the local test numbers use.
# Hosted with WhatsApp codes ready: whatsapp,sms (SMS is offered as "Send code by SMS instead").
# NEXT_PUBLIC_LOGIN_CHANNELS=whatsapp,sms
# Who picks the channel: channel (default, Supabase's built-in Twilio provider honours the pick) or hook
# (the Send SMS hook picks; with two channels the screen then names both instead of one).
# NEXT_PUBLIC_LOGIN_DELIVERY=channel
