# Copy to apps/web/.env.local. Values for the local stack come from `pnpm supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WhatsApp platform number (digits, with country code) for customer invites, and the grievance contact shown to customers
NEXT_PUBLIC_WHATSAPP_NUMBER=919000012345
NEXT_PUBLIC_GRIEVANCE_CONTACT=Grievance officer: (name), grievance@example.in, +91 90000 00000
