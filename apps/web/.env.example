# Copy to apps/web/.env.local. Values for the local stack come from `pnpm supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WhatsApp platform number (digits, with country code) for customer invites, and the grievance contact shown to customers
NEXT_PUBLIC_WHATSAPP_NUMBER=919000012345
NEXT_PUBLIC_GRIEVANCE_CONTACT=Grievance officer: (name), grievance@example.in, +91 90000 00000

# Error reporting (D-092): Sentry DSN for the web app. Inlined at build time, so set it before `next build`.
# Nothing is sent when unset. Phone numbers and customer-page tokens are masked before sending.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_RELEASE=tiffin-web@0.1.0

# Product analytics (optional, D-092): PostHog, public website only, off when unset and for visitors
# with Do Not Track. Turn on only after the privacy policy mentions analytics.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
