# Copy to apps/mobile/.env.local.
# On a real phone, 127.0.0.1 is the phone itself: use your computer's LAN IP, e.g. http://192.168.1.20:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Public web app, for the privacy policy and terms links (required for the app stores), e.g. https://app.example.in
# EXPO_PUBLIC_WEB_URL=

# M8: error reporting (optional). Errors are sent only when set; phone numbers are masked.
# EXPO_PUBLIC_SENTRY_DSN=

# Login channels offered, in order (docs/LOGIN.md). Inlined at build time. Unset = sms (local test numbers).
# EXPO_PUBLIC_LOGIN_CHANNELS=whatsapp,sms
# channel (default, built-in Twilio provider) or hook (Send SMS hook: channel-neutral screen). Build time.
# EXPO_PUBLIC_LOGIN_DELIVERY=channel
