# Every environment variable the platform uses. Never commit real values.
# Each app reads its own file: apps/web/.env.local, apps/mobile/.env.local (see their .env.example).

# ---------------------------------------------------------------------------
# M1: Supabase (local values: `pnpm supabase status`)
# ---------------------------------------------------------------------------
# Web dashboard (apps/web/.env.local)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mobile app (apps/mobile/.env.local). On a real phone use your computer's LAN IP, not 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Integration tests (optional; defaults to the running local stack)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Phone encryption keys are NOT env vars: they live in Supabase Vault (see CLAUDE.md > Secrets).

# ---------------------------------------------------------------------------
# Later milestones (not used yet)
# ---------------------------------------------------------------------------
# Server-only Supabase key for Edge Functions / workers (M3+). Never expose to browsers or apps.
# SUPABASE_SERVICE_ROLE_KEY=

# M3: Razorpay (TEST MODE ONLY until the product owner approves live keys)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# M4: WhatsApp Cloud API
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# M4: Claude API (chat fallback only)
# ANTHROPIC_API_KEY=

# M5: Routing and geocoding
# VROOM_URL=
# OLA_MAPS_API_KEY=
# GOOGLE_MAPS_API_KEY=

# M8: Monitoring
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
