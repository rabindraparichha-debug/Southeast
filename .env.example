# Every environment variable the platform uses. Never commit real values.
# Each app reads its own file: apps/web/.env.local, apps/mobile/.env.local (see their .env.example).

# ---------------------------------------------------------------------------
# M1: Supabase (local values: `pnpm supabase status`)
# ---------------------------------------------------------------------------
# Web dashboard (apps/web/.env.local)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mobile app (apps/mobile/.env.local). On a real phone use your computer's LAN IP, not 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Integration tests (optional; defaults to the running local stack)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Phone encryption keys are NOT env vars: they live in Supabase Vault (see CLAUDE.md > Secrets).

# ---------------------------------------------------------------------------
# Later milestones (not used yet)
# ---------------------------------------------------------------------------
# Server-only Supabase key for Edge Functions / workers (M3+). Never expose to browsers or apps.
# SUPABASE_SERVICE_ROLE_KEY=

# M3: Razorpay. These are EDGE FUNCTION secrets: put them in supabase/functions/.env
# (template: supabase/functions/.env.example) or `supabase secrets set` in a hosted project.
# TEST MODE ONLY until the product owner approves live keys.
# RAZORPAY_MODE=mock               # mock | test
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# PUBLIC_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1
# RAZORPAY_ALLOW_LIVE=             # never set without the owner's explicit approval

# M4: WhatsApp Cloud API + Claude fallback. EDGE FUNCTION secrets (supabase/functions/.env).
# WHATSAPP_MODE=mock               # mock | live
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# PUBLIC_WEB_URL=http://localhost:3000
# ANTHROPIC_API_KEY=               # optional; without it a rule-based fallback hands off
# ANTHROPIC_MODEL=claude-opus-5-5

# M4 web (apps/web/.env.local)
# NEXT_PUBLIC_WHATSAPP_NUMBER=919000012345
# NEXT_PUBLIC_GRIEVANCE_CONTACT=Grievance officer: name, email, phone

# M5: Routing. EDGE FUNCTION secrets (supabase/functions/.env). Optional: without VROOM_URL the
# built-in optimiser is used (D-067).
# VROOM_URL=http://your-vps:3000
# VROOM_USE_ROUTING=false          # true only if the VROOM server has its own OSRM/ORS
# Geocoding (typed-address search) is not used yet (D-068):
# OLA_MAPS_API_KEY=
# GOOGLE_MAPS_API_KEY=

# M7: Lead intake. EDGE FUNCTION secrets (supabase/functions/.env).
# LEAD_INTAKE_KEY=                 # Justdial push + generic JSON (?key=...)
# GOOGLE_ADS_LEAD_KEY=             # the key you enter in the Google Ads lead form webhook
# The same LEAD_INTAKE_KEY also protects lead-email (Sulekha/Justdial enquiry emails). docs/LEAD_SOURCES.md

# M9: Google Ads offline conversions. EDGE FUNCTION secrets. Mock (nothing sent) unless
# GOOGLE_ADS_MODE=live and a developer token are set.
# GOOGLE_ADS_MODE=mock
# GOOGLE_ADS_CUSTOMER_ID=          # 123-456-7890
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=    # manager (MCC) account, only if used
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_API_VERSION=v21
# GOOGLE_ADS_CONVERSION_TRIAL=     # conversion action ids (ctId)
# GOOGLE_ADS_CONVERSION_PLAN=
# GOOGLE_ADS_CONVERSION_RENEWAL=

# M9: Mobile builds (apps/mobile/scripts/build-apk.sh; CI secrets in .github/workflows)
# EXPO_PUBLIC_WEB_URL=                    # apps/mobile: public web app for the in-app privacy/terms links (app stores require them)
# EXPO_PUBLIC_ALLOW_SERVER_SWITCH=false   # true in test APKs: the login screen can change the server
# ANDROID_KEYSTORE=~/.tiffin/upload.keystore   # never commit; keep it and its password safe
# ANDROID_KEY_ALIAS=tiffin-upload
# ANDROID_KEY_PASSWORD=
# MAVEN_MIRROR=                    # optional Maven Central mirror when repo.maven.apache.org rate-limits
# Vault secret (not an env var): public_web_url, base URL for links in WhatsApp messages.

# M8: Monitoring (all optional; nothing is sent when unset; phone numbers are masked)
# SENTRY_DSN=                      # Edge Function secret (supabase/functions/.env)
# SENTRY_ENVIRONMENT=production    # Edge Function secret
# NEXT_PUBLIC_SENTRY_DSN=          # apps/web/.env.local
# EXPO_PUBLIC_SENTRY_DSN=          # apps/mobile/.env.local
# NEXT_PUBLIC_POSTHOG_KEY=         # apps/web: product analytics, only after the privacy policy mentions it
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# P5: Rain and heat alerts. EDGE FUNCTION secrets (supabase/functions/.env).
# WEATHER_MODE=mock                # mock (default, no network) | live (Open-Meteo, free, no API key)
# WEATHER_MOCK_SCENARIO=none       # none | rain | heat (mock mode only)
# OPEN_METEO_URL=                  # optional override of https://api.open-meteo.com/v1/forecast

# P6: Notebook-photo import. EDGE FUNCTION secret; uses ANTHROPIC_API_KEY / ANTHROPIC_MODEL above
# and returns a fixture preview without a key.
# NOTEBOOK_IMPORT_MODE=            # set to mock to force the fixture even with a key
